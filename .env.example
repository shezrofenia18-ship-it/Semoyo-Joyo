# Salin menjadi .env di root repo (untuk docker compose) atau isi di tab Environment Variables Coolify.

# PostgreSQL (service `postgres` di docker-compose.yml)
POSTGRES_DB=mbg_erp
POSTGRES_USER=mbg_user
POSTGRES_PASSWORD=change_this_password

# Backend
JWT_SECRET=please-change-this-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
OWNER_USERNAME=owner
OWNER_PASSWORD=owner123

# Domain publik frontend, mis. https://toko.domain.com (dipakai untuk URL webhook/link)
APP_URL=
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# BATPay (batbiz.id) - Bayar Online: QRIS & Virtual Account (SNAP API)
# Kosongkan semua = mode placeholder (opsi Bayar Online tampil nonaktif di checkout).
# Dokumentasi: https://developer.batbiz.id
# ---------------------------------------------------------------------------
BATPAY_ENV=sandbox                     # sandbox | production
BATPAY_BASE_URL=                       # kosong = otomatis: https://openapi.sandbox.batbiz.id / https://openapi.batbiz.id
BATPAY_CLIENT_KEY=                     # Client Key / Partner ID dari dashboard BATPay (X-CLIENT-KEY, X-PARTNER-ID)
BATPAY_CLIENT_SECRET=                  # Client Secret (HMAC_SHA512 signature transaksi & verifikasi webhook)
BATPAY_PRIVATE_KEY=                    # Private key RSA-2048 PKCS8 partner: isi PEM (baris baru sebagai \n), path file, atau base64 PEM
BATPAY_MERCHANT_ID=                    # Merchant ID BATPay (wajib untuk QRIS)
BATPAY_CHANNEL_ID=95221                # CHANNEL-ID (identitas kanal partner)
BATPAY_PUBLIC_KEY=                     # Opsional: override public key BATPay (default: kunci resmi sandbox/production dari dokumentasi)
BATPAY_WEBHOOK_TOKEN=                  # Opsional: token internal header X-CALLBACK-TOKEN untuk uji webhook manual
BATPAY_EXPIRE_MINUTES=60               # Masa berlaku QRIS / VA

# Biaya layanan yang dibebankan ke pembeli (gross-up otomatis dari MDR agar dana cair ke toko utuh)
BATPAY_FEE_PERCENT=0.7                 # MDR default semua kanal (%)
BATPAY_FEE_FIXED=0                     # biaya tetap default semua kanal (Rp)
# Opsional: override per kanal (kosong = pakai default di atas)
BATPAY_QRIS_FEE_PERCENT=
BATPAY_QRIS_FEE_FIXED=
BATPAY_VA_FEE_PERCENT=
BATPAY_VA_FEE_FIXED=
BATPAY_VA_BANKS=BCA,MANDIRI,CIMB,DANAMON   # bank VA yang ditawarkan ke pembeli
