# Salin menjadi .env di root repo (untuk docker compose) atau isi di tab Environment Variables Coolify.

# PostgreSQL (service `postgres` di docker-compose.yml)
POSTGRES_DB=mbg_erp
POSTGRES_USER=mbg_user
POSTGRES_PASSWORD=change_this_password

# Backend
JWT_SECRET=please-change-this-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
OWNER_USERNAME=owner
OWNER_PASSWORD=owner123

# Domain publik frontend, mis. https://toko.domain.com (dipakai untuk URL webhook/link)
APP_URL=
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# BATPay (batbiz.id) - Bayar Online: QRIS & Virtual Account (SNAP API)
# Kosongkan semua = mode placeholder (opsi Bayar Online tampil nonaktif di checkout).
# Dokumentasi: https://developer.batbiz.id
# ---------------------------------------------------------------------------
BATPAY_ENV=sandbox                     # sandbox | production
BATPAY_BASE_URL=                       # kosong = otomatis: https://openapi.sandbox.batbiz.id / https://openapi.batbiz.id (staging: https://sg-openapi.batbiz.id)
BATPAY_PARTNER_ID=                     # Partner ID dari dashboard BATPay (header X-PARTNER-ID saat transaksi)
BATPAY_CLIENT_ID=                      # Client ID dari dashboard BATPay (header X-CLIENT-KEY saat minta token B2B)
BATPAY_SECRET_KEY=                     # Secret Key (HMAC_SHA512 signature transaksi & verifikasi webhook)
BATPAY_PRIVATE_KEY=                    # Private key RSA-2048 PKCS8 partner: isi PEM (baris baru sebagai \n), path file, atau base64 PEM
BATPAY_MERCHANT_ID=                    # Merchant ID BATPay (wajib untuk QRIS)
BATPAY_CHANNEL_ID=95221                # CHANNEL-ID (identitas kanal partner)
BATPAY_PUBLIC_KEY=                     # Opsional: override public key BATPay (default: kunci resmi sandbox/production dari dokumentasi)
BATPAY_WEBHOOK_TOKEN=                  # Opsional: token internal header X-CALLBACK-TOKEN untuk uji webhook manual
BATPAY_EXPIRE_MINUTES=60               # Masa berlaku QRIS / VA
# Kill-switch: true = integrasi DITAHAN walau kredensial lengkap (tidak ada panggilan apa pun ke server BATPay;
# checkout Bayar Online tetap placeholder). Pakai selagi BATPay memproses whitelist API. Hapus/false untuk mengaktifkan.
BATPAY_FORCE_PLACEHOLDER=false

# Biaya layanan yang dibebankan ke pembeli - ATURAN DEFAULT TERTANAM DI KODE (backend/payments/batpay.py):
#   QRIS bertingkat : belanja <= Rp500.000 gratis; > Rp500.000 dikenai 0,3% gross-up (dana cair ke toko utuh)
#   VA tarif flat   : BCA Rp4.000, BSI Rp2.500, bank lain Rp2.000 per transaksi
# Variabel di bawah OPSIONAL, hanya untuk override tanpa ubah kode (kosong = pakai default).
BATPAY_QRIS_FEE_THRESHOLD=             # ambang gratis QRIS (Rp), default 500000
BATPAY_QRIS_FEE_PERCENT=               # persen di atas ambang, default 0.3
BATPAY_VA_FLAT_FEES=                   # tarif khusus per bank, mis. bca=4000,bsi=2500
BATPAY_VA_FLAT_FEE_DEFAULT=            # tarif bank lain (Rp), default 2000
# Bank VA yang ditawarkan ke pembeli. Kosong = semua: BCA,MANDIRI,BRI,BNI,BSI,CIMB,DANAMON,PERMATA,BTN,BJB,NEO
BATPAY_VA_BANKS=
# Override additionalInfo.paymentType SNAP per bank bila kode BATPay berbeda dari konvensi <BANK>_DYNAMIC, mis. neo=NEOBANK_DYNAMIC
BATPAY_VA_PAYMENT_TYPES=
