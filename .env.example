# Salin menjadi .env di root repo (untuk docker compose) atau isi di tab Environment Variables Coolify.

# PostgreSQL (service `postgres` di docker-compose.yml)
POSTGRES_DB=mbg_erp
POSTGRES_USER=mbg_user
POSTGRES_PASSWORD=change_this_password

# Backend
JWT_SECRET=please-change-this-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
OWNER_USERNAME=owner
OWNER_PASSWORD=owner123

# Domain publik frontend, mis. https://toko.domain.com (dipakai untuk callback/link)
APP_URL=
CORS_ORIGINS=*

# Travoy Pay - Transfer Virtual Account (kosongkan = mode placeholder, menunggu dokumen API)
TRAVOY_API_KEY=
TRAVOY_BASE_URL=
TRAVOY_CALLBACK_TOKEN=
